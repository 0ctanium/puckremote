{
  "name": "@poc/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-agnostic host engine: artifacts, isolate, data, Puck rendering, editor.",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/server/config.ts",
    "./cacheability": "./src/server/cacheability.ts",
    "./react": "./src/react/index.ts",
    "./editor": "./src/editor/index.ts"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--no-node-snapshot vitest run",
    "bench": "NODE_OPTIONS=--no-node-snapshot tsx scripts/bench.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@poc/sdk": "workspace:*",
    "@puckeditor/core": "0.23.0",
    "html-react-parser": "6.1.8",
    "isolated-vm": "7.0.1",
    "undici": "8.11.2",
    "zod": "4.6.5"
  },
  "peerDependencies": { "react": "19.3.0", "react-dom": "19.3.0" },
  "devDependencies": {
    "@poc/cli": "workspace:*",
    "@poc/pages-fs": "workspace:*",
    "@poc/source-mock": "workspace:*",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "mock-api": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
