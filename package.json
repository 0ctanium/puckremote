{
  "name": "puck-repository-poc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm -r --parallel --filter \"./packages/*\" --filter host dev",
    "typecheck": "pnpm -r --filter \"./packages/*\" --filter theme --filter host typecheck",
    "test": "pnpm build && pnpm -r --workspace-concurrency=1 test",
    "lint:pkg": "pnpm -r --filter \"./packages/*\" lint:pkg",
    "changeset": "changeset",
    "release": "pnpm build && pnpm lint:pkg && changeset publish",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "adr": "node .claude/adr-helper.mjs",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "publint": "0.3.25",
    "smol-toml": "1.9.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  }
}
